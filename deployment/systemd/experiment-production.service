[Unit]
Description=UCS vs CS Experiment - Production Environment
After=network.target network-online.target nginx.service
Wants=network-online.target nginx.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ucs-vs-cs-experiment

# 本番環境用の設定
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/opt/ucs-vs-cs-experiment
Environment=PORT=9876
Environment=HOST=127.0.0.1
Environment=TMPDIR=/opt/ucs-vs-cs-experiment/tmp

# 実行コマンド
ExecStart=/opt/ucs-vs-cs-experiment/venv-aws/bin/gunicorn --config /opt/ucs-vs-cs-experiment/deployment/gunicorn_production.conf.py wsgi:app
ExecReload=/bin/kill -HUP $MAINPID

# ヘルスチェック
ExecStartPost=/bin/sleep 5
ExecStartPost=/bin/bash -c 'timeout 15 bash -c "until curl -f http://127.0.0.1:9876/health 2>/dev/null; do sleep 1; done"'

# 本番環境用再起動設定
Restart=on-failure
RestartSec=30
StartLimitInterval=600
StartLimitBurst=3
RestartPreventExitStatus=1 2 3

# プロセス管理
PIDFile=/opt/ucs-vs-cs-experiment/logs/gunicorn.pid
ExecStop=/bin/kill -TERM $MAINPID
ExecStopPost=/bin/rm -f /opt/ucs-vs-cs-experiment/logs/gunicorn.pid

# タイムアウト設定
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# 本番環境用セキュリティ設定
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/ucs-vs-cs-experiment/logs /opt/ucs-vs-cs-experiment/data /opt/ucs-vs-cs-experiment/tmp
ProtectHome=yes

# ログ設定
StandardOutput=journal
StandardError=journal
SyslogIdentifier=experiment-prod

[Install]
WantedBy=multi-user.target
