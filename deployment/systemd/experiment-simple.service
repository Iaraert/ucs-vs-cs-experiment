[Unit]
Description=UCS vs CS Experiment Production Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/experiment

# 本番環境用の設定
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/opt/experiment
Environment=PORT=9876
Environment=HOST=127.0.0.1

# 実行コマンド
ExecStart=/opt/experiment/venv/bin/python server.py
ExecReload=/bin/kill -HUP $MAINPID

# 再起動の設定（安全な設定）
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=3

# セキュリティ設定（最小限）
NoNewPrivileges=yes
PrivateTmp=yes

# ログ設定
StandardOutput=journal
StandardError=journal
SyslogIdentifier=experiment-app

# プロセス制限
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target