[Unit]
Description=UCS vs CS Experiment Production Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ucs-vs-cs-experiment

# 本番環境用の設定
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/opt/ucs-vs-cs-experiment
Environment=PORT=9876
Environment=HOST=127.0.0.1

# 実行コマンド
ExecStart=/opt/ucs-vs-cs-experiment/venv/bin/python server.py
ExecReload=/bin/kill -HUP $MAINPID

# ヘルスチェック（アプリケーション起動確認）
ExecStartPost=/bin/sleep 5
ExecStartPost=/bin/bash -c 'timeout 10 bash -c "until curl -f http://127.0.0.1:9876/health || nc -z 127.0.0.1 9876; do sleep 1; done"'

# 安全な再起動制御（ループ防止）
Restart=on-failure
RestartSec=30
StartLimitInterval=600
StartLimitBurst=3
RestartPreventExitStatus=1 2 3

# プロセス制限とタイムアウト
TimeoutStartSec=60
TimeoutStopSec=30
TimeoutSec=0
KillMode=mixed
KillSignal=SIGTERM

# 追加のセキュリティ設定
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/ucs-vs-cs-experiment/logs /opt/ucs-vs-cs-experiment/data
ProtectHome=yes

# ログ設定
StandardOutput=journal
StandardError=journal
SyslogIdentifier=experiment-app

[Install]
WantedBy=multi-user.target